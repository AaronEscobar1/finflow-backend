# Puerto del servidor HTTP
PORT=8080
# Entorno: local | qa | production
GO_ENV=local

# PostgreSQL (la base se crea automáticamente si no existe)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finflow?sslmode=disable

# Secreto para firmar JWT (>=32 bytes aleatorios). OBLIGATORIO en runtime.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32+bytes
# API Key para endpoints administrativos. OBLIGATORIO en runtime.
ADMIN_API_KEY=cambia-esta-api-key-admin

# Correo (opcional; sin esto el mailer usa Mock/consola)
RESEND_API_KEY=
RESEND_FROM=FinFlow <onboarding@resend.dev>

# Google OAuth (opcional; necesario para POST /api/auth/google)
GOOGLE_CLIENT_ID=
